# SQLite database location. Created on first run if missing.
GUESSEE_DB_PATH=./data/guessee.db

# Required to reach /editor. Any non-empty value works; use a long random string.
GUESSEE_EDITOR_KEY=change-me

# Secret used to sign round tokens so the reveal endpoint can tell a finished
# round from an in-progress one. Falls back to a dev-only value if unset.
GUESSEE_TOKEN_SECRET=dev-only-insecure-secret
