# SQLite database location. Created on first run if missing.
GUESSEE_DB_PATH=./data/guessee.db

# Required to reach /editor. Any non-empty value works; use a long random string.
GUESSEE_EDITOR_KEY=change-me

# Secret used to sign round tokens so the reveal endpoint can tell a finished
# round from an in-progress one. Falls back to a dev-only value if unset.
GUESSEE_TOKEN_SECRET=dev-only-insecure-secret

# Separate key for the scheduled missing-puzzle check, so a cron job does not
# need the editor key. Unset means only the editor key is accepted there.
# GUESSEE_ALERT_TOKEN=change-me-too

# Where the missing-puzzle alert is posted when a day is uncovered. Accepts a
# Slack or Discord incoming webhook; the body is {"text": "..."}.
# GUESSEE_ALERT_WEBHOOK=https://hooks.slack.com/services/...

# Origin used in share links, e.g. https://guessee.example
# NEXT_PUBLIC_SITE_ORIGIN=https://guessee.example
